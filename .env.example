# ============================================================
# JiraForge · Environment Variables
# Copy to .env.local (Next.js) — never commit with real values
# ============================================================

# ─── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Encryption ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=your-32-char-minimum-secret-key-here

# ─── Internal API ──────────────────────────────────────────
# Used by roll-up service to fetch decrypted credentials
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=your-internal-api-secret

# ─── Atlassian OAuth (for OAuth connections) ───────────────
ATLASSIAN_CLIENT_ID=your-atlassian-oauth-app-client-id
ATLASSIAN_CLIENT_SECRET=your-atlassian-oauth-app-client-secret
ATLASSIAN_REDIRECT_URI=https://jiraforge.vercel.app/api/connections/oauth/callback

# ─── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://jiraforge.vercel.app
